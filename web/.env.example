# Network the app opens on by default: mainnet (the real demo) | testnet
NEXT_PUBLIC_DEFAULT_NETWORK=mainnet

# Privy app id from https://dashboard.privy.io (25 characters).
# Leave blank to fall back to injected/MetaMask wallets.
NEXT_PUBLIC_PRIVY_APP_ID=

# Public URL of the deployed app. Used by the QR card and share intent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ClawMachine addresses (0x...). Leave empty until the contract is deployed.
NEXT_PUBLIC_CLAW_MACHINE_MAINNET=
NEXT_PUBLIC_CLAW_MACHINE_TESTNET=

# Testnet MockUSDC address (has a public faucet() that mints 100 USDC).
NEXT_PUBLIC_USDC_TESTNET=

# Optional backend base URL (no trailing slash). Used for the connected
# player's indexed history; the global live feed still comes from chain events.
NEXT_PUBLIC_BACKEND_URL=

# Server-only Pyth Hermes API key. NEVER prefix this with NEXT_PUBLIC_.
# Used by src/app/api/price-update/route.ts; it never reaches the browser.
PYTH_API_KEY=

# Optional Hermes base override (default https://pyth.dourolabs.app/hermes).
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes

# mock = simulated pulls, no wallet or chain needed (great for UI work / demos)
NEXT_PUBLIC_DEMO_MODE=
