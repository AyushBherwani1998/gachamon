# Server Configuration
PORT=3000

# Monad RPC Configuration
RPC_URL=https://rpc.monad.xyz
WS_URL=wss://rpc.monad.xyz

# Contract Addresses
CLAW_MACHINE_ADDRESS=0x0000000000000000000000000000000000000000
PYTH_PRICE_FEED_ADDRESS=0xB754BA51E3861Ac0Cb67f73CD046dE790A36508d

# Pyth Hermes API (server-side only: never expose this key in browser code
# and never prefix it with NEXT_PUBLIC_ or VITE_)
PYTH_API_KEY=your-pyth-api-key-here
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes/v2/updates/price/latest

# Comma-separated symbols requested when the contract is not configured.
# Only list feeds the API key is entitled to (a non-entitled feed -> HTTP 403).
PYTH_FEEDS=TSLAx

# Optional feed ID overrides for symbols in PYTH_FEEDS.
# Our current Hermes key is only entitled to TSLA/USD; the other feeds below
# return 403 until entitlement is added. When CLAW_MACHINE_ADDRESS is set the
# backend reads feed IDs from the contract instead.
PYTH_FEED_TSLA=0x16dad506d7db8da01c87581c87ca897a012a153557d4d578c3b9c9e1bc0632f1
PYTH_FEED_NVDA=0xb1073854ed24cbc755dc527418f52b7d271f6cc967bbf8d8129112b18860a593
PYTH_FEED_AAPL=0x49f6b65cb1de6b10eaf75e7c03ca029c306d0357e91b5311b175084a5ad55688
PYTH_FEED_SPY=0x19e09bb805456ada3979a7d1cbb4b6d63babc3a0f8e8a9509f68afa5c4c11cd5
