# Network: "mainnet" (chain 143) or "testnet" (chain 10143)
NETWORK=mainnet
PORT=3000

# Optional RPC overrides. Defaults follow NETWORK:
#   mainnet: https://rpc.monad.xyz / wss://rpc.monad.xyz
#   testnet: https://testnet-rpc.monad.xyz / wss://testnet-rpc.monad.xyz
# RPC_URL=https://rpc.monad.xyz
# WS_URL=wss://rpc.monad.xyz

# Deployed ClawMachine address (required for /machine and the indexer)
CLAW_MACHINE_ADDRESS=0x0000000000000000000000000000000000000000

# Block the ClawMachine was deployed at. Required for backfilling history;
# without it the indexer starts at the current head.
START_BLOCK=0

# Indexer
# Monad public RPC limits eth_getLogs block ranges; 100 is a safe default.
INDEXER_BLOCK_RANGE=100
INDEXER_POLL_INTERVAL_MS=3000

# Optional transaction relay (off by default). The backend never holds keys.
RELAY_ENABLED=false
MAX_GAS_LIMIT=500000
RATE_LIMIT_WINDOW_MS=3000

# SQLite database file (defaults to ./claw-machine.db)
# DATABASE_PATH=claw-machine.db
